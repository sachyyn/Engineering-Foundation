{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["vite/client"],
    "baseUrl": "..",
    "paths": { "@/*": ["frontend/src/*"] }
  },
  "include": ["../frontend/src/**/*.ts", "../frontend/src/**/*.vue"]
}
